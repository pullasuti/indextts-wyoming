# Copy to .env to override run.sh defaults. All values are optional.

# Reference voice to clone (10-15 s clean mono WAV; the model uses at most
# 15 s of it) and the name HA shows.
PROMPT_WAV=voices/nicoleheart.wav
VOICE=nicoleheart

# Mood for text before any mood tag (warm, confident, happy, calm, ...).
# Empty uses the reference clip's own emotion (no emotion vector).
DEFAULT_MOOD=warm

# Multiplier on every mood's emotion vector (see MOODS in bridge_indextts.py).
EMO_STRENGTH=1.0

# Wyoming listen address and model language (EN, ZH, JA, ES, AR).
URI=tcp://0.0.0.0:10300
LANG_CODE=EN

# 1.0 = normal speaking rate. NUM_BEAMS: GPT beam width (model default 3).
SPEED=1.0
NUM_BEAMS=1

# Streaming: audio held before playback starts, and how much speech to merge
# per model call after the first sentence.
PREBUFFER_SECONDS=1
MIN_MERGED_SECONDS=2.5

# Extra bridge arguments, string or array: EXTRA_ARGS=(--no-bf16)
#EXTRA_ARGS=
